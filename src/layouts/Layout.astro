---
import { Font } from "astro:assets"
import { Rss } from "@lucide/astro"
import Header from "@/components/header/index.astro"
import ThemeScript from "@/components/header/ThemeScript.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts"
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props
const currentYear = new Date().getFullYear()
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ThemeScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />
    <Font cssVariable="--font-geist" preload={[{ subset: "latin", style: "normal" }]} />
    <Font cssVariable="--font-noto" preload={false} />
    <Font cssVariable="--font-code" preload={false} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">跳至正文</a>
    <div class="site-shell">
      <Header />
      <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
      <footer class="site-footer">
        <a href="/" class="footer-name">leekoho</a>
        <div class="footer-end">
          <a class="footer-feed" href="/feed.xml"
            ><Rss size={13} stroke-width={1.5} aria-hidden="true" />RSS</a
          >
          <span>© {currentYear}</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-body {
    overflow-x: clip;
  }
  .site-shell {
    display: flex;
    flex-direction: column;
    width: min(100%, 768px);
    min-height: 100svh;
    margin-inline: auto;
    border-inline: 1px solid var(--ui-border);
    background: var(--ui-bg);
  }
  .site-main {
    flex: 1;
    min-width: 0;
  }
  .site-main:focus {
    outline: none;
  }
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 28px;
    border-top: 1px solid var(--ui-border);
    color: var(--ui-text-muted);
    font-size: 11px;
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--ui-text);
  }
  .footer-name {
    font-family: var(--font-geist), sans-serif;
    letter-spacing: -0.2px;
  }
  .footer-end {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .footer-feed {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 16px;
    transform: translateY(-150%);
    background: var(--ui-bg);
    border: 1px solid var(--ui-border);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  @media (max-width: 520px) {
    .site-footer {
      padding: 20px;
    }
  }
  @media (pointer: coarse) {
    .site-footer a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>

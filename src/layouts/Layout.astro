---
import { Font } from "astro:assets"
import SiteFooter from "@/components/SiteFooter.astro"
import Header from "@/components/header/index.astro"
import ThemeScript from "@/components/header/ThemeScript.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts"
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
  publishedAt?: Date
  tags?: readonly string[]
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION, publishedAt, tags } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ThemeScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />
    <Font cssVariable="--font-geist" preload={[{ subset: "latin", style: "normal" }]} />
    <Font cssVariable="--font-noto" preload={false} />
    <Font cssVariable="--font-code" preload={false} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">跳至正文</a>
    <div class="site-shell">
      <Header />
      <main id="main-content" class="site-main" tabindex="-1"><slot /></main>
      <SiteFooter publishedAt={publishedAt} tags={tags} />
    </div>
  </body>
</html>

<style>
  .site-body {
    overflow-x: clip;
  }
  .site-shell {
    display: flex;
    flex-direction: column;
    width: min(100%, 768px);
    min-height: 100svh;
    margin-inline: auto;
    border-inline: 1px solid var(--ui-border);
    background: var(--ui-bg);
  }
  .site-main {
    flex: 1;
    min-width: 0;
  }
  .site-main:focus {
    outline: none;
  }
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 10px 16px;
    transform: translateY(-150%);
    background: var(--ui-bg);
    border: 1px solid var(--ui-border);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
</style>

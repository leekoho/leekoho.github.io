---
import { Font } from "astro:assets"
import Footer from "@/components/Footer.astro"
import Header from "@/components/header/index.astro"
import ThemeScript from "@/components/header/ThemeScript.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "@/consts"
import "@fontsource-variable/noto-sans-sc"
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
}
const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <ThemeScript />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed.xml" />
    <Font cssVariable="--font-geist" preload={[{ subset: "latin", style: "normal" }]} />
    <Font cssVariable="--font-code" preload={false} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="site-body">
    <a class="skip-link" href="#main-content">跳至正文</a>
    <div class="site-shell">
      <Header />
      <main id="main-content" class="site-main" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  .site-body {
    @apply overflow-x-clip;
  }
  .skip-link {
    @apply fixed top-2 left-2 z-100 -translate-y-24 border border-border bg-background px-4 py-3 focus:translate-y-0;
  }
  .site-shell {
    @apply mx-auto flex min-h-svh w-full max-w-3xl flex-col border-x border-border bg-background;
  }
  .site-main {
    @apply min-w-0 flex-1 focus:outline-none;
  }
</style>

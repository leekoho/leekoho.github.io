---
import {
  Code,
  Command,
  Cpu,
  Globe,
  Keyboard,
  Monitor,
  Mouse,
  Network,
  Terminal,
  Type,
} from "@lucide/astro"
import Layout from "@/layouts/Layout.astro"
import { PROFILE } from "@/consts.ts"
// import Button from "@/components/Button.astro"

const useIcons = {
  code: Code,
  command: Command,
  cpu: Cpu,
  globe: Globe,
  keyboard: Keyboard,
  monitor: Monitor,
  mouse: Mouse,
  network: Network,
  terminal: Terminal,
  type: Type,
} as const
---

<Layout title="About · leekoho" description="关于我，以及日常使用的设备与工具。">
  <section aria-labelledby="about-title">
    <header class="page-heading page-rule">
      <h1 id="about-title" class="section-title">About</h1>
      <p class="section-summary">关于我，以及日常使用的设备与工具。</p>
    </header>

    <div class="section-divider page-rule" aria-hidden="true"></div>

    <section aria-labelledby="profile-title " class="">
      <header class="about-section-heading page-rule">
        <h2 class="about-section-title" id="profile-title">基本信息</h2>
      </header>
      <dl class="profile-list">
        <div class="profile-row">
          <dt class="profile-label">名字</dt>
          <dd class="profile-value">{PROFILE.name}</dd>
        </div>
        <div class="profile-row">
          <dt class="profile-label">身份</dt>
          <dd class="profile-value">
            {PROFILE.tags.join(" / ")}
          </dd>
        </div>

        <div class="profile-row">
          <dt class="profile-label">现居</dt>
          <dd class="profile-value">{PROFILE.city}</dd>
        </div>
        <div class="profile-row">
          <dt class="profile-label">邮箱</dt>
          <dd class="profile-value">
            <a href={`mailto:${PROFILE.email}`} class="link">{PROFILE.email}</a>
          </dd>
        </div>
      </dl>
    </section>

    <div class="section-divider page-rule" aria-hidden="true"></div>


---
import { ArrowUpRight } from "@lucide/astro"
import Layout from "@/layouts/Layout.astro"
import { PROFILE } from "@/consts.ts"
---

<Layout title="关于我 · leekoho" description="关于 leekoho，以及日常使用的设备与工具。">
  <section aria-labelledby="about-title">
    <header class="page-heading page-rule">
      <h1 id="about-title" class="section-title">关于我</h1>
      <p class="section-summary">我是 {PROFILE.name}，一名写代码的人。</p>
    </header>

    <div class="section-divider page-rule" aria-hidden="true"></div>

    <div class="about-intro page-rule">
      <p>
        {PROFILE.description || "这个博客用来整理开发中的问题，写清过程，也保留当时的取舍。"}
      </p>
      <p>希望这些记录，能在下一次遇到类似问题时派上用场。</p>
    </div>

    <section aria-labelledby="profile-title">
      <header class="about-section-heading page-rule">
        <h2 id="profile-title">基本信息</h2>
      </header>
      <dl class="profile-list">
        <div class="profile-row">
          <dt>名字</dt>
          <dd>{PROFILE.name}</dd>
        </div>
        <div class="profile-row">
          <dt>身份</dt>
          <dd>{PROFILE.tags.join(" / ")}</dd>
        </div>
        <div class="profile-row">
          <dt>现居</dt>
          <dd>{PROFILE.city}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="links-title">
      <header class="about-section-heading page-rule">
        <h2 id="links-title">在别处</h2>
      </header>
      <ul class="about-links">
        {
          PROFILE.links.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="about-link">
                <span class="about-link-label">{item.label}</span>
                <span class="about-link-address">{item.url.replace(/^https?:\/\//, "")}</span>
                <ArrowUpRight size={16} stroke-width={1.5} aria-hidden="true" />
                <span class="sr-only">（在新标签页打开）</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="section-divider page-rule" aria-hidden="true"></div>

    <section aria-labelledby="uses-title">
      <header class="about-section-heading page-rule">
        <h2 id="uses-title">工作台</h2>
        <p>日常使用的设备与软件</p>
      </header>
      {
        PROFILE.uses.map((group, index) => (
          <section aria-labelledby={`uses-group-${index}`}>
            <h3 id={`uses-group-${index}`} class="uses-category page-rule">
              {group.category}
            </h3>
            <ul class="uses-list">
              {group.items.map((item) => (
                <li class="uses-row">
                  <h4 class="uses-name">{item.name}</h4>
                  {item.description && <p class="uses-description">{item.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
    <div class="about-end-space page-rule" aria-hidden="true"></div>
  </section>
</Layout>

<style>
  .about-intro {
    padding: 30px 28px;
    color: var(--ui-text-secondary);
    font-size: 15px;
    line-height: 2;
    letter-spacing: 0.015em;
  }

  .about-intro p + p {
    margin-top: 12px;
  }

  .about-section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 28px;
  }

  .about-section-heading h2 {
    color: var(--ui-text);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.6;
  }

  .about-section-heading p {
    color: var(--ui-text-muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .profile-list,
  .about-links,
  .uses-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .profile-row {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 16px;
    padding: 16px 28px;
    border-bottom: 1px solid var(--ui-border);
    font-size: 13px;
    line-height: 1.8;
  }

  .profile-row dt {
    color: var(--ui-text-muted);
  }

  .profile-row dd {
    margin: 0;
    color: var(--ui-text-secondary);
    overflow-wrap: anywhere;
  }

  .about-link {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 16px;
    min-height: 56px;
    padding: 16px 28px;
    border-bottom: 1px solid var(--ui-border);
    color: var(--ui-text-muted);
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .about-link:hover {
    background: var(--ui-bg-soft);
  }

  .about-link:focus-visible {
    outline: 2px solid var(--ui-text);
    outline-offset: -3px;
  }

  .about-link-label {
    color: var(--ui-text);
    font-size: 13px;
    font-weight: 500;
  }

  .about-link-address {
    font-size: 12px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .uses-category {
    padding: 10px 28px;
    background: var(--ui-bg-soft);
    color: var(--ui-text-muted);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.8;
  }

  .uses-row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    align-items: baseline;
    gap: 18px;
    padding: 19px 28px;
    border-bottom: 1px solid var(--ui-border);
  }

  .uses-name {
    color: var(--ui-text);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .uses-description {
    color: var(--ui-text-muted);
    font-size: 13px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .about-end-space {
    height: 32px;
  }

  @media (max-width: 520px) {
    .about-intro {
      padding: 24px 20px;
      font-size: 14px;
    }

    .about-section-heading,
    .profile-row,
    .about-link,
    .uses-category,
    .uses-row {
      padding-inline: 20px;
    }

    .profile-row {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 12px;
    }

    .about-link {
      grid-template-columns: 64px minmax(0, 1fr) 16px;
      gap: 12px;
    }

    .about-link-address {
      font-size: 11px;
    }

    .uses-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
      padding-block: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-link {
      transition: none;
    }
  }
</style>

---
import { ArrowUpRight } from "@lucide/astro"
import Layout from "@/layouts/Layout.astro"
import { PROFILE } from "@/consts.ts"
---

<Layout title="About · leekoho" description="关于 leekoho，以及日常使用的设备与工具。">
  <section aria-labelledby="about-title">
    <header class="page-heading page-rule">
      <h1 id="about-title" class="section-title">About</h1>
      <p class="section-summary">{PROFILE.description || `我是 ${PROFILE.name}`}</p>
    </header>

    <div class="section-divider page-rule" aria-hidden="true"></div>

    {
      PROFILE.description && (
        <div class="about-intro page-rule">
          <p>
            {PROFILE.description || "这个博客用来整理开发中的问题，写清过程，也保留当时的取舍。"}
          </p>
          <p>希望这些记录，能在下一次遇到类似问题时派上用场。</p>
        </div>
      )
    }

    <section aria-labelledby="profile-title">
      <header class="about-section-heading page-rule">
        <h2 id="profile-title">基本信息</h2>
      </header>
      <dl class="profile-list">
        <div class="profile-row">
          <dt>名字</dt>
          <dd>{PROFILE.name}</dd>
        </div>
        <div class="profile-row">
          <dt>身份</dt>
          <dd>
            {PROFILE.tags.join(" / ")}
          </dd>
        </div>
        <div class="profile-row">
          <dt>现居</dt>
          <dd>{PROFILE.city}</dd>
        </div>
      </dl>
    </section>

    <section aria-labelledby="links-title">
      <header class="about-section-heading page-rule">
        <h2 id="links-title">在别处</h2>
      </header>
      <ul class="about-links">
        {
          PROFILE.links.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="about-link">
                <span class="about-link-label">{item.label}</span>
                <span class="about-link-address">{item.url.replace(/^https?:\/\//, "")}</span>
                <ArrowUpRight
                  class="about-link-icon"
                  size={16}
                  stroke-width={1.5}
                  aria-hidden="true"
                />
                <span class="sr-only">（在新标签页打开）</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="section-divider page-rule" aria-hidden="true"></div>

    <section aria-labelledby="uses-title">
      <header class="about-section-heading page-rule">
        <h2 id="uses-title">工作台</h2>
        <p>日常使用的设备与软件</p>
      </header>
      {
        PROFILE.uses.map((group, index) => (
          <section aria-labelledby={`uses-group-${index}`}>
            <h3 id={`uses-group-${index}`} class="uses-category page-rule">
              {group.category}
            </h3>
            <ul class="uses-list">
              {group.items.map((item) => (
                <li class="uses-row">
                  <h4 class="uses-name">{item.name}</h4>
                  {item.description && <p class="uses-description">{item.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
    <div class="about-end-space page-rule" aria-hidden="true"></div>
  </section>
</Layout>

<style>
  @reference "../../styles/global.css";

  .about-intro {
    @apply space-y-4 px-4 py-8 text-sm leading-8 text-foreground-soft sm:px-6 sm:text-base;
  }
  .about-section-heading {
    @apply flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 px-4 py-4 sm:px-6;
  }
  .about-section-heading h2 {
    @apply text-sm leading-relaxed font-medium text-foreground;
  }
  .profile-list {
    @apply m-0 grid grid-cols-3 p-0;
  }
  .profile-row {
    @apply flex flex-col gap-2 border-r border-b border-border px-4 py-4 text-sm leading-6 sm:px-6;
  }
  .profile-row dt {
    @apply shrink-0 text-xs text-muted sm:w-28;
  }
  .profile-row dd {
    @apply m-0 min-w-0 flex-1 wrap-anywhere text-foreground-soft;
  }
  .about-links {
    @apply m-0 list-none p-0;
  }
  .about-link {
    @apply flex min-h-14 items-center gap-4 border-b border-border px-4 py-4 text-muted no-underline hover:bg-background-muted focus-visible:-outline-offset-4 sm:px-6;
  }
  .about-link-label {
    @apply w-16 shrink-0 text-sm font-medium text-foreground sm:w-28;
  }
  .about-link-address {
    @apply min-w-0 flex-1 text-xs leading-relaxed wrap-anywhere;
  }
  .about-link :global(.about-link-icon) {
    @apply shrink-0;
  }
  .about-section-heading p {
    @apply text-xs leading-relaxed text-muted;
  }
  .uses-category {
    @apply bg-background-muted px-4 py-2 text-xs leading-6 font-normal text-muted sm:px-6;
  }
  .uses-list {
    @apply m-0 list-none p-0;
  }
  .uses-row {
    @apply flex flex-col gap-2 border-b border-border px-4 py-4 sm:flex-row sm:items-baseline sm:gap-4 sm:px-6;
  }
  .uses-name {
    @apply text-sm leading-6 font-medium wrap-anywhere text-foreground sm:w-48 sm:shrink-0;
  }
  .uses-description {
    @apply min-w-0 flex-1 text-sm leading-6 wrap-anywhere text-muted;
  }
  .about-end-space {
    @apply h-8 sm:h-12;
  }
</style>

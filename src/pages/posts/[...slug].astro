---
import PostTags from "@/components/posts/PostTags"
import { articleComponents } from "@/components/posts/mdx-components"
import Layout from "@/layouts/Layout.astro"
import { render } from "astro:content"
import ArticleImageLightbox from "@/components/posts/ArticleImageLightbox"
import { getPosts } from "@/lib/posts"

export const prerender = true

export async function getStaticPaths() {
  const posts = await getPosts()

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const { pubDate, tags = [] } = post.data

const dateTime = pubDate?.toISOString()

const dateLabel = dateTime?.slice(0, 10)
---

<Layout title={`${post.data.title} · leekoho`} description={post.data.description}>
  <article class="article-shell" aria-labelledby="article-title">
    <header class="article-heading page-rule">
      <div class="article-kicker">
        <a class="article-back" href="/posts">
          Posts
        </a>
        {tags.length > 0 && (
          <>
            <span class="article-kicker-divider" aria-hidden="true">
              /
            </span>
            <PostTags tags={tags} />
          </>
        )}
      </div>
      <h1 class="article-title" id="article-title">
        {post.data.title}
      </h1>
      {post.data.description && <p class="article-description">{post.data.description}</p>}
      {dateTime && (
        <p class="article-date">
          <time datetime={dateTime}>{dateLabel}</time>
        </p>
      )}
    </header>

    <div class="typeset typeset-docs article-content article-body" data-article-body>
      <Content components={articleComponents} />
    </div>
  </article>

  <ArticleImageLightbox client:idle />
</Layout>

<style>
  @reference "../../styles/global.css";

  .article-shell {
    @apply w-full min-w-0;
  }
  .article-heading {
    @apply px-4 py-6 sm:px-6 sm:py-8;
  }
  .article-kicker {
    @apply flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs leading-5 text-muted-foreground;
  }
  .article-back {
    @apply no-underline hover:text-foreground pointer-coarse:inline-flex pointer-coarse:min-h-11 pointer-coarse:items-center;
  }
  .article-kicker-divider {
    @apply text-subtle;
  }
  :global(.article-tags) {
    @apply m-0 flex list-none flex-wrap items-center gap-x-3 gap-y-1 p-0;
  }
  :global(.article-tag) {
    @apply text-xs leading-5 hover:text-foreground pointer-coarse:min-h-11;
  }
  .article-title {
    @apply mt-4 mb-0 text-3xl leading-snug font-medium tracking-tight text-balance wrap-anywhere sm:text-4xl;
  }
  .article-description {
    @apply mt-4 mb-0 text-sm leading-7 wrap-anywhere text-muted-foreground sm:text-base sm:leading-8;
  }
  .article-date {
    @apply mt-4 mb-0 font-mono text-xs leading-5 text-muted-foreground;
  }
</style>

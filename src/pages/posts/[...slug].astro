---
import Layout from "@/layouts/Layout.astro"
import { getCollection, render } from "astro:content"
import EncryptedContent from "@/components/EncryptedContent.astro"
import ArticleToolbar from "@/components/posts/ArticleToolbar.astro"
import { PROFILE } from "@/consts.ts"

export async function getStaticPaths() {
  const posts = (
    await getCollection("posts", ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
  ).toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

  const link = (post: (typeof posts)[number] | undefined) =>
    post ? { href: `/posts/${post.id}`, title: post.data.title } : undefined

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, previous: link(posts[index - 1]), next: link(posts[index + 1]) },
  }))
}

const { post, previous, next } = Astro.props
const { Content } = await render(post)

const { pubDate, tags = [] } = post.data

const dateTime = pubDate?.toISOString()

const dateLabel = dateTime?.slice(0, 10).replaceAll("-", ".")
---

<Layout title={`${post.data.title} · leekoho`} description={post.data.description}>
  <article class="article-shell" aria-labelledby="article-title">
    <div class="article-space page-rule" aria-hidden="true"></div>
    <ArticleToolbar previous={previous} next={next} />

    <header class="article-heading">
      <h1 class="page-rule" id="article-title">
        {post.data.title}
      </h1>
      {
        post.data.description && (
          <p class="article-description" data-article-description>
            {post.data.description}
          </p>
        )
      }
    </header>

    <div class="article-content prose" data-article-body>
      <EncryptedContent password={post.data.password}>
        <Content />
      </EncryptedContent>
    </div>
  </article>

  <div class="footer-divider page-rule" aria-hidden="true"></div>

  <dl class="footer-grid page-rule" aria-label={pubDate ? "文章信息" : "作者信息"}>
    <div class="footer-cell">
      <dt>作者</dt>
      <dd>
        <a href="/about" rel="author">{PROFILE.name}</a>
      </dd>
    </div>
    {
      dateTime && (
        <div class="footer-cell">
          <dt>日期</dt>
          <dd>
            <time datetime={dateTime}>{dateLabel}</time>
          </dd>
        </div>
      )
    }
    {
      tags.length > 0 && (
        <div class="footer-cell">
          <dt>标签</dt>
          <dd>{tags.join(" / ")}</dd>
        </div>
      )
    }
  </dl>
</Layout>

<style>
  @reference "../../styles/global.css";

  .article-shell {
    @apply w-full min-w-0;
  }
  .article-space {
    @apply h-8 sm:h-12;
  }
  .article-heading {
    @apply pt-6 sm:pt-8;
  }
  .article-heading h1 {
    @apply m-0 px-4 pb-6 text-3xl leading-snug font-medium tracking-tight text-balance wrap-anywhere sm:px-6 sm:pb-8 sm:text-4xl;
  }
  .article-description {
    @apply m-0 mt-6 px-4 text-sm leading-7 wrap-anywhere text-muted sm:px-6 sm:text-base sm:leading-8;
  }
  .article-content {
    @apply max-w-none min-w-0 px-4 pt-6 pb-8 text-base leading-8 wrap-anywhere sm:px-6 sm:pt-8 sm:pb-12;
  }
  .footer-divider {
    @apply h-8 border-t border-border sm:h-12;
  }
  .footer-grid {
    @apply m-0 grid grid-cols-2 sm:grid-cols-3;
  }
  .footer-cell {
    @apply min-w-0 border-r border-border p-4 last:border-r-0 only:col-span-full max-sm:even:border-r-0 sm:px-6 max-sm:[&:nth-child(3)]:col-span-full max-sm:[&:nth-child(3)]:border-t;
  }
  dt {
    @apply mb-2 text-xs leading-5 tracking-wide text-muted;
  }
  dd {
    @apply m-0 font-mono text-sm leading-6 wrap-anywhere text-foreground;
  }
  dd a {
    @apply underline decoration-border-strong underline-offset-4 hover:decoration-current pointer-coarse:inline-flex pointer-coarse:min-h-11 pointer-coarse:items-center;
  }
  .article-content :global(> :first-child) {
    @apply mt-0;
  }
  .article-content :global(> :last-child) {
    @apply mb-0;
  }
  .article-content :global(img) {
    @apply rounded-lg border border-border;
  }
  .footer-divider::before {
    content: "";
    @apply pointer-events-none absolute inset-y-0 left-1/2 w-screen -translate-x-1/2;
    background: repeating-linear-gradient(
      135deg,
      transparent 0,
      transparent 6px,
      var(--ui-pattern) 6px,
      var(--ui-pattern) 7px
    );
  }
</style>

---
import Layout from "@/layouts/Layout.astro"
import { getCollection, render } from "astro:content"
import EncryptedContent from "@/components/EncryptedContent.astro"
import ArticleToolbar from "@/components/posts/ArticleToolbar.astro"

export async function getStaticPaths() {
  const posts = (
    await getCollection("posts", ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
  ).toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

  const link = (post: (typeof posts)[number] | undefined) =>
    post ? { href: `/posts/${post.id}`, title: post.data.title } : undefined

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, previous: link(posts[index - 1]), next: link(posts[index + 1]) },
  }))
}

const { post, previous, next } = Astro.props
const { Content } = await render(post)
---

<Layout
  title={`${post.data.title} · leekoho`}
  description={post.data.description}
  publishedAt={post.data.pubDate}
  tags={post.data.tags}
>
  <article class="article-shell" aria-labelledby="article-title">
    <div class="article-space page-rule" aria-hidden="true"></div>
    <ArticleToolbar previous={previous} next={next} />

    <header class="article-heading">
      <h1 class="page-rule" id="article-title">{post.data.title}</h1>
      {
        post.data.description && (
          <p class="article-description" data-article-description>
            {post.data.description}
          </p>
        )
      }
    </header>

    <div class="article-content prose" data-article-body>
      <EncryptedContent password={post.data.password}>
        <Content />
      </EncryptedContent>
    </div>
  </article>
</Layout>

<style>
  .article-shell {
    min-width: 0;
    width: 100%;
  }
  .article-space {
    height: 48px;
  }
  .article-heading {
    padding-top: 16px;
  }
  .article-heading h1 {
    margin: 0;
    padding: 0 16px 5px;
    font: 500 36px/1.35 var(--font-sans);
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }
  .article-description {
    margin: 28px 16px 0;
    color: var(--ui-text-muted);
    font-size: 16px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }
  .article-content {
    min-width: 0;
    max-width: none;
    padding: 32px 16px 48px;
    font-size: 16px;
    line-height: 1.95;
    letter-spacing: 0.012em;
    overflow-wrap: anywhere;
  }
  .article-content :global(> :first-child) {
    margin-top: 0;
  }
  .article-content :global(> :last-child) {
    margin-bottom: 0;
  }
  .article-content :global(img) {
    border: 1px solid var(--ui-border);
    border-radius: 10px;
  }
  @media (max-width: 520px) {
    .article-space {
      height: 28px;
    }
    .article-heading h1 {
      font-size: 30px;
      line-height: 1.45;
      letter-spacing: -0.015em;
    }
    .article-description {
      margin-top: 22px;
      font-size: 14px;
      line-height: 1.95;
    }
    .article-content {
      padding-top: 26px;
      padding-bottom: 36px;
    }
  }
  @media (max-width: 340px) {
    .article-heading h1 {
      font-size: 27px;
    }
  }
</style>

---
import TagList from "@/components/TagList"
import Layout from "@/layouts/Layout.astro"
import { getPosts, getTags } from "@/lib/posts"

const tags = getTags(await getPosts())
---

<Layout title="Tags · leekoho" description="按标签浏览文章。">
  <section aria-labelledby="tags-title">
    <header class="page-heading page-rule">
      <h1 class="section-title" id="tags-title">
        Tags
      </h1>
      <p class="section-summary">{tags.length} 个标签</p>
    </header>
    <div class="section-divider page-rule" aria-hidden="true"></div>
    <TagList tags={tags} />
    {tags.length === 0 && <p class="px-4 py-6 text-sm text-muted-foreground sm:px-6">还没有标签。</p>}
    <div class="h-8 sm:h-12" aria-hidden="true"></div>
  </section>
</Layout>

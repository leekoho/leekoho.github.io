---
import PostList from "@/components/posts/PostList"
import Layout from "@/layouts/Layout.astro"
import { getPosts, getTags, toPostSummary } from "@/lib/posts"

export const prerender = true

export async function getStaticPaths() {
  const posts = await getPosts()

  return getTags(posts).map(({ name }) => ({
    params: { tag: name },
    props: { tag: name, posts: posts.filter((post) => post.data.tags.includes(name)) },
  }))
}

const { tag, posts } = Astro.props
---

<Layout title={`${tag} · Tags · leekoho`} description={`标签“${tag}”下的文章。`}>
  <PostList
    posts={posts.map(toPostSummary)}
    title={`# ${tag}`}
    description={`${posts.length} 篇文章`}
  />
</Layout>

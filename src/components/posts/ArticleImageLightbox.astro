---
import { X } from "@lucide/astro"
---

<dialog class="article-lightbox" aria-label="图片预览">
  <img class="article-lightbox__image" alt="" />
  <button type="button" class="article-lightbox__close" aria-label="关闭图片预览">
    <X size={20} stroke-width={1.5} aria-hidden="true" />
  </button>
</dialog>

<script>
  let cleanup = () => {}

  const initArticleImageLightbox = () => {
    cleanup()

    const dialog = document.querySelector<HTMLDialogElement>(".article-lightbox")
    const preview = dialog?.querySelector<HTMLImageElement>(".article-lightbox__image")
    const article = document.querySelector<HTMLElement>("[data-article-body]")

    if (!dialog || !preview || !article) return

    let source: HTMLImageElement | null = null
    let closing = false
    let animation: Animation | null = null

    const rectToKeyframe = (rect: DOMRect) => ({
      left: `${rect.left}px`,
      top: `${rect.top}px`,
      width: `${rect.width}px`,
      height: `${rect.height}px`,
    })

    const getTargetRect = (image: HTMLImageElement) => {
      const ratio = image.naturalWidth / image.naturalHeight
      const maxWidth = window.innerWidth * 0.92
      const maxHeight = window.innerHeight * 0.92
      let width = Math.min(image.naturalWidth, maxWidth)
      let height = width / ratio

      if (height > maxHeight) {
        height = maxHeight
        width = height * ratio
      }

      return new DOMRect(
        (window.innerWidth - width) / 2,
        (window.innerHeight - height) / 2,
        width,
        height,
      )
    }

    const setPreviewRect = (rect: DOMRect) => {
      Object.assign(preview.style, rectToKeyframe(rect))
    }

    const cancelAnimation = () => {
      animation?.cancel()
      animation = null
    }

    const animatePreview = async (from: DOMRect, to: DOMRect, easing: string) => {
      cancelAnimation()
      // Keep the final rectangle in normal styles so resize can update it after the animation.
      setPreviewRect(to)
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return

      const current = preview.animate([rectToKeyframe(from), rectToKeyframe(to)], {
        duration: 280,
        easing,
        fill: "both",
      })
      animation = current

      try {
        await current.finished
      } catch (error) {
        if (!(error instanceof DOMException) || error.name !== "AbortError") throw error
      } finally {
        if (animation === current) animation = null
        current.cancel()
      }
    }

    const close = async () => {
      const image = source
      if (!image || closing) return

      closing = true
      const sourceRect = image.getBoundingClientRect()
      const previewRect = preview.getBoundingClientRect()

      try {
        await animatePreview(previewRect, sourceRect, "cubic-bezier(0.32, 0.72, 0, 1)")
      } finally {
        if (source !== image) return
        dialog.close()
        preview.removeAttribute("style")
        preview.removeAttribute("src")
        source = null
        closing = false
        image.focus({ preventScroll: true })
      }
    }

    const open = async (image: HTMLImageElement) => {
      if (source || !image.naturalWidth) return

      source = image
      preview.src = image.currentSrc || image.src
      preview.alt = image.alt
      dialog.showModal()

      await new Promise((resolve) => requestAnimationFrame(resolve))

      if (source !== image || closing) return
      await animatePreview(
        image.getBoundingClientRect(),
        getTargetRect(image),
        "cubic-bezier(0.22, 1, 0.36, 1)",
      )
    }

    const prepareImages = () => {
      article.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
        if (image.closest("a, button")) return
        image.tabIndex = 0
        image.setAttribute("role", "button")
        image.setAttribute("aria-haspopup", "dialog")
        image.setAttribute("aria-label", image.alt ? `预览图片：${image.alt}` : "预览图片")
      })
    }
    prepareImages()
    // Password-protected articles insert their images after being unlocked.
    const observer = new MutationObserver(prepareImages)
    observer.observe(article, { childList: true, subtree: true })

    const onArticleClick = (event: MouseEvent) => {
      const target = event.target
      if (!(target instanceof HTMLImageElement) || target.getAttribute("role") !== "button") return

      event.preventDefault()
      void open(target)
    }

    const onArticleKeydown = (event: KeyboardEvent) => {
      if (event.key !== "Enter" && event.key !== " ") return
      const target = event.target
      if (!(target instanceof HTMLImageElement) || target.getAttribute("role") !== "button") return

      event.preventDefault()
      void open(target)
    }

    const onDialogClick = (event: MouseEvent) => {
      const target = event.target
      if (
        target === dialog ||
        target === preview ||
        (target instanceof Element && target.closest(".article-lightbox__close"))
      ) {
        void close()
      }
    }

    const onDialogCancel = (event: Event) => {
      event.preventDefault()
      void close()
    }

    const onResize = () => {
      if (!source || closing) return
      cancelAnimation()
      setPreviewRect(getTargetRect(source))
    }

    article.addEventListener("click", onArticleClick)
    article.addEventListener("keydown", onArticleKeydown)
    dialog.addEventListener("click", onDialogClick)
    dialog.addEventListener("cancel", onDialogCancel)
    window.addEventListener("resize", onResize)

    cleanup = () => {
      cancelAnimation()
      observer.disconnect()
      if (dialog.open) dialog.close()
      article.removeEventListener("click", onArticleClick)
      article.removeEventListener("keydown", onArticleKeydown)
      dialog.removeEventListener("click", onDialogClick)
      dialog.removeEventListener("cancel", onDialogCancel)
      window.removeEventListener("resize", onResize)
      preview.removeAttribute("style")
      preview.removeAttribute("src")
      source = null
      closing = false
    }
  }

  document.addEventListener("astro:page-load", initArticleImageLightbox)
  document.addEventListener("astro:before-swap", () => cleanup())
  initArticleImageLightbox()
</script>

<style is:global>
  .article-lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden;
    background: transparent;
  }

  .article-lightbox::backdrop {
    background: rgb(0 0 0 / 78%);
  }

  .article-lightbox__image {
    position: fixed;
    display: block;
    max-width: none;
    max-height: none;
    margin: 0;
    object-fit: contain;
    cursor: zoom-out;
  }

  .article-lightbox__close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 255 255 / 30%);
    border-radius: 50%;
    color: white;
    background: rgb(0 0 0 / 50%);
  }

  .article-lightbox__close:focus-visible {
    outline-color: white;
  }

  [data-article-body] img[role="button"] {
    cursor: zoom-in;
  }
</style>

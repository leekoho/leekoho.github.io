---
import { ArrowLeft, ArrowRight, Copy, Link } from "@lucide/astro"
import Button from "../Button.astro"

interface Props {
  previous?: { href: string; title: string }
  next?: { href: string; title: string }
}

const { previous, next } = Astro.props
---

<div class="article-toolbar page-rule" data-article-tools>
  <Button variant="link" size="sm" class="article-back" href="/posts">
    <ArrowLeft size={16} stroke-width={1.5} aria-hidden="true" />
    Blog
  </Button>
  <div class="article-actions">
    <Button
      class="article-action copy-article"
      variant="outline"
      size="sm"
      data-copy="article"
      disabled
      aria-label="复制正文"
    >
      <Copy size={16} stroke-width={1.5} aria-hidden="true" />
      <span class="copy-article-label">复制正文</span>
    </Button>
    <Button
      class="article-action"
      variant="outline"
      size="icon-sm"
      data-copy="link"
      disabled
      aria-label="复制链接"
      title="复制链接"
    >
      <Link size={16} stroke-width={1.5} aria-hidden="true" />
    </Button>
    {
      (previous || next) && (
        <nav class="article-pagination" aria-label="相邻文章">
          {previous && (
            <Button
              class="article-action"
              variant="ghost"
              size="icon-sm"
              href={previous.href}
              rel="prev"
              aria-label={`上一篇：${previous.title}`}
              title={`上一篇：${previous.title}`}
            >
              <ArrowLeft size={16} stroke-width={1.5} aria-hidden="true" />
            </Button>
          )}
          {next && (
            <Button
              class="article-action"
              variant="ghost"
              size="icon-sm"
              href={next.href}
              rel="next"
              aria-label={`下一篇：${next.title}`}
              title={`下一篇：${next.title}`}
            >
              <ArrowRight size={16} stroke-width={1.5} aria-hidden="true" />
            </Button>
          )}
        </nav>
      )
    }
  </div>
  <span class="copy-status" role="status" aria-live="polite" aria-atomic="true"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-article-tools]").forEach((toolbar) => {
    const article = toolbar.closest("article")
    const content = article?.querySelector<HTMLElement>("[data-article-body]")
    const copyArticle = toolbar.querySelector<HTMLButtonElement>('[data-copy="article"]')
    const copyLink = toolbar.querySelector<HTMLButtonElement>('[data-copy="link"]')
    const status = toolbar.querySelector<HTMLElement>('[role="status"]')
    if (!article || !content || !copyArticle || !copyLink || !status) return

    const isLocked = () => Boolean(content.querySelector("encrypted-content"))
    const syncCopy = () => {
      copyArticle.disabled = isLocked()
      copyArticle.title = isLocked() ? "解锁后可复制正文" : "复制正文"
    }
    syncCopy()
    copyLink.disabled = false

    if (isLocked()) {
      const observer = new MutationObserver(() => {
        syncCopy()
        if (!isLocked()) observer.disconnect()
      })
      observer.observe(content, { childList: true })
    }

    let feedbackTimer: ReturnType<typeof setTimeout>
    const report = (message: string) => {
      clearTimeout(feedbackTimer)
      status.textContent = message
      feedbackTimer = setTimeout(() => {
        status.textContent = ""
      }, 3000)
    }

    toolbar.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const copyBody = button.dataset.copy === "article"
        if (copyBody && isLocked()) return
        const text = copyBody
          ? [
              article.querySelector("h1")?.textContent?.trim(),
              article.querySelector("[data-article-description]")?.textContent?.trim(),
              content.innerText.trim(),
            ]
              .filter(Boolean)
              .join("\n\n")
          : `${window.location.origin}${window.location.pathname}`

        button.disabled = true
        button.setAttribute("aria-busy", "true")
        try {
          await navigator.clipboard.writeText(text)
          report(copyBody ? "正文已复制" : "链接已复制")
        } catch {
          report(copyBody ? "复制失败，请选中正文后手动复制。" : "复制失败，请从地址栏复制链接。")
        } finally {
          button.removeAttribute("aria-busy")
          button.disabled = copyBody && isLocked()
        }
      })
    })
  })
</script>

<style>
  @reference "../../styles/global.css";

  .article-toolbar {
    @apply relative flex min-h-12 flex-wrap items-center justify-between gap-x-3 gap-y-2 px-4 py-2 sm:px-6;
  }
  .article-back {
    @apply -ml-2 px-2 font-normal tracking-wide text-muted;
  }
  .article-actions {
    @apply ml-auto flex items-center gap-2;
  }
  .copy-article {
    @apply w-8 px-0 sm:w-auto sm:px-3 pointer-coarse:min-w-11;
  }
  .copy-article-label {
    @apply hidden sm:inline;
  }
  .article-pagination {
    @apply flex items-center gap-2 border-l border-border pl-2;
  }
  .copy-status {
    @apply absolute top-full right-4 left-4 z-10 mt-2 w-fit max-w-full justify-self-end rounded-sm border border-border bg-background px-3 py-2 text-xs leading-5 text-foreground-soft shadow-card empty:hidden sm:right-6 sm:left-6;
  }
</style>

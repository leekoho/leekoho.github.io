---
import { type CollectionEntry, getCollection } from "astro:content"
import { FileText, LockKeyhole, ArrowUpRight } from "@lucide/astro"
import { SITE_DESCRIPTION } from "@/consts"

type Post = CollectionEntry<"posts">
const allPosts = (
  await getCollection("posts", ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
).toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
const groups = new Map<number, Post[]>()
allPosts.forEach((post) => {
  const year = post.data.pubDate.getUTCFullYear()
  if (!groups.has(year)) groups.set(year, [])
  groups.get(year)!.push(post)
})
---

<div class="post-shell">
  <header class="page-heading page-rule">
    <h1 class="section-title">Blog</h1>
    <p class="section-summary">{SITE_DESCRIPTION}</p>
  </header>
  <div class="section-divider page-rule" aria-hidden="true"></div>
  <section aria-labelledby="archive-title">
    <div class="archive-bar page-rule">
      <h2 class="archive-title" id="archive-title">Posts</h2>
      <!--<span>按年份归档</span>-->
    </div>
    {
      Array.from(groups).map(([year, yearPosts]) => (
        <section aria-labelledby={`post-year-${year}`}>
          <h3 class="post-year page-rule" id={`post-year-${year}`}>
            {year}
          </h3>
          <ul class="post-list">
            {yearPosts.map((post) => (
              <li class="page-rule">
                <a href={`/posts/${post.id}`} class="post-link">
                  <span class="post-icon" aria-hidden="true">
                    {post.data.password ? (
                      <LockKeyhole size={20} stroke-width={1.5} />
                    ) : (
                      <FileText size={20} stroke-width={1.5} />
                    )}
                  </span>
                  <span class="post-copy">
                    <span class="post-title">{post.data.title}</span>
                    {/* 列表摘要按当前设计隐藏。 */}
                    <span class="post-meta">
                      <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                        {post.data.pubDate.toISOString().slice(5, 10).replace("-", ".")}
                      </time>
                      {post.data.tags.length > 0 && (
                        <>
                          <span class="post-meta-rule" aria-hidden="true" />
                          <span class="post-tags">
                            {post.data.tags.map((tag) => (
                              <span class="post-tag">{tag}</span>
                            ))}
                          </span>
                        </>
                      )}
                      {post.data.password && <span class="sr-only">密码保护</span>}
                      {post.data.draft && <span class="post-draft">草稿</span>}
                    </span>
                  </span>
                  <span class="post-arrow" aria-hidden="true">
                    <ArrowUpRight size={16} stroke-width={1.5} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>
  <div class="archive-end" aria-hidden="true"></div>
</div>

<style>
  @reference "../../styles/global.css";

  .post-shell {
    @apply min-w-0;
  }
  .archive-bar {
    @apply flex items-center justify-between gap-4 px-4 py-4 sm:px-6;
  }
  .archive-title {
    @apply text-lg font-medium tracking-wide;
  }
  .post-year {
    @apply bg-background-muted px-4 py-2 font-mono text-xs leading-6 tracking-wide text-muted sm:px-6;
  }
  .post-list {
    @apply m-0 list-none p-0;
  }
  .post-link {
    @apply flex gap-3 px-4 py-6 text-foreground no-underline hover:bg-hover focus-visible:-outline-offset-4 sm:gap-4 sm:px-6;
  }
  .post-icon {
    @apply flex w-5 shrink-0 justify-center pt-1 text-muted;
  }
  .post-copy {
    @apply min-w-0 flex-1;
  }
  .post-title {
    @apply block text-base leading-7 font-medium text-pretty wrap-anywhere;
  }
  .post-meta {
    @apply mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-5 text-muted;
  }
  .post-date {
    @apply font-mono tabular-nums;
  }
  .post-meta-rule {
    @apply h-3 w-px bg-border-strong;
  }
  .post-tags {
    @apply flex flex-wrap gap-2 wrap-anywhere;
  }
  .post-tag + .post-tag::before {
    @apply mr-2 content-['·'];
  }
  .post-draft {
    @apply rounded-sm border border-border px-1;
  }
  .post-arrow {
    @apply flex w-4 shrink-0 justify-end pt-1.5 text-muted;
  }
  .archive-end {
    @apply h-8 sm:h-12;
  }
</style>

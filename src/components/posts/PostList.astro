---
import { FileText, LockKeyhole, ArrowUpRight } from "@lucide/astro"
import { Item, ItemContent, ItemMedia, ItemTitle, ItemActions } from "@/components/starwind/item"
import { Badge } from "@/components/starwind/badge"
import { SITE_DESCRIPTION } from "@/consts"
import { getPosts, type Post } from "@/lib/posts"

interface Props {
  posts?: Post[]
  title?: string
  description?: string
}

const { posts, title = "Posts", description = SITE_DESCRIPTION } = Astro.props

const groups = new Map<number, Post[]>()

const allPosts = posts ?? (await getPosts())

allPosts.forEach((post) => {
  const year = post.data.pubDate.getUTCFullYear()
  if (!groups.has(year)) groups.set(year, [])
  groups.get(year)!.push(post)
})
---

<div class="post-shell">
  <header class="page-heading page-rule">
    <h1 class="section-title">{title}</h1>
    <p class="section-summary">{description}</p>
  </header>
  <div class="section-divider page-rule" aria-hidden="true"></div>
  <section aria-labelledby="archive-title">
    <div class="archive-bar page-rule">
      <h2 class="archive-title" id="archive-title">
        Archive
      </h2>
      <!--<span>按年份归档</span>-->
    </div>
    {Array.from(groups).map(([year, yearPosts]) => (
      <section aria-labelledby={`post-year-${year}`}>
        <h3 class="post-year page-rule" id={`post-year-${year}`}>
          {year}
        </h3>
        <ul class="post-list">
          {yearPosts.map((post) => (
            <li class="page-rule">
              <Item
                as="a"
                href={`/posts/${post.id}`}
                class="post-link flex-nowrap items-start rounded-none border-0"
              >
                <ItemMedia class="post-icon" aria-hidden="true">
                  {post.data.password ? (
                    <LockKeyhole class="size-5 stroke-1" />
                  ) : (
                    <FileText class="size-5 stroke-1" />
                  )}
                </ItemMedia>
                <ItemContent class="post-copy gap-0">
                  <ItemTitle class="post-title w-full">{post.data.title}</ItemTitle>
                  {/* 列表摘要按当前设计隐藏。 */}
                  <div class="post-meta">
                    <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toISOString().slice(5, 10)}
                    </time>
                    {post.data.tags.length > 0 && (
                      <>
                        <span class="post-meta-rule" aria-hidden="true" />
                        <div class="post-tags">
                          {post.data.tags.map((tag) => (
                            <Badge
                              tone="neutral"
                              appearance="text"
                              size="sm"
                              class="post-tag font-normal text-muted-foreground"
                            >
                              {tag}
                            </Badge>
                          ))}
                        </div>
                      </>
                    )}
                    {post.data.password && <span class="sr-only">密码保护</span>}
                    {post.data.draft && (
                      <Badge variant="outline" size="sm" class="rounded-sm px-1 py-0 font-normal">
                        草稿
                      </Badge>
                    )}
                  </div>
                </ItemContent>
                <ItemActions class="post-arrow" aria-hidden="true">
                  <ArrowUpRight class="size-4 stroke-1" />
                </ItemActions>
              </Item>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
  <div class="archive-end" aria-hidden="true"></div>
</div>

<style>
  @reference "../../styles/global.css";

  .post-shell {
    @apply min-w-0;
  }
  .archive-bar {
    @apply flex items-center justify-between gap-4 px-4 py-4 sm:px-6;
  }
  .archive-title {
    @apply text-lg font-medium tracking-wide;
  }
  .post-year {
    @apply bg-background-muted px-4 py-2 font-mono text-xs leading-6 tracking-wide text-muted-foreground sm:px-6;
  }
  .post-list {
    @apply m-0 list-none p-0;
  }
  :global(.post-link) {
    @apply gap-3 px-4 py-6 text-foreground no-underline hover:bg-hover focus-visible:-outline-offset-4 sm:gap-4 sm:px-6;
  }
  :global(.post-icon) {
    @apply flex w-5 shrink-0 justify-center pt-1 text-muted-foreground;
  }
  :global(.post-copy) {
    @apply min-w-0 flex-1;
  }
  :global(.post-title) {
    @apply block text-base leading-7 font-medium text-pretty wrap-anywhere;
  }
  .post-meta {
    @apply mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs leading-5 text-muted-foreground;
  }
  .post-date {
    @apply font-mono tabular-nums;
  }
  .post-meta-rule {
    @apply h-3 w-px bg-border-strong;
  }
  .post-tags {
    @apply flex flex-wrap gap-2 wrap-anywhere;
  }
  :global(.post-tag + .post-tag)::before {
    @apply mr-2 content-['·'];
  }
  :global(.post-arrow) {
    @apply flex w-4 shrink-0 justify-end pt-1.5 text-muted-foreground;
  }
  .archive-end {
    @apply h-8 sm:h-12;
  }
</style>

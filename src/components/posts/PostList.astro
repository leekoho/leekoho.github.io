---
import { type CollectionEntry, getCollection } from "astro:content"
import { FileText, LockKeyhole, ArrowUpRight } from "@lucide/astro"
import { SITE_DESCRIPTION } from "@/consts"

type Post = CollectionEntry<"posts">
const allPosts = (
  await getCollection("posts", ({ data }) => (import.meta.env.PROD ? data.draft !== true : true))
).toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
const groups = new Map<number, Post[]>()
allPosts.forEach((post) => {
  const year = post.data.pubDate.getUTCFullYear()
  if (!groups.has(year)) groups.set(year, [])
  groups.get(year)!.push(post)
})
---

<div class="post-shell">
  <header class="page-heading page-rule">
    <h1 class="section-title">Blog</h1>
    <p class="section-summary">{SITE_DESCRIPTION}</p>
  </header>
  <div class="section-divider page-rule" aria-hidden="true"></div>
  <section aria-labelledby="archive-title">
    <div class="archive-bar page-rule">
      <h2 id="archive-title">文章</h2>
      <span>按年份归档</span>
    </div>
    {
      allPosts.length === 0 ? (
        <p class="post-empty">文章正在整理中。</p>
      ) : (
        Array.from(groups).map(([year, yearPosts]) => (
          <section aria-labelledby={`post-year-${year}`}>
            <h3 class="post-year page-rule" id={`post-year-${year}`}>
              {year}
            </h3>
            <ul class="post-list">
              {yearPosts.map((post) => (
                <li class="page-rule">
                  <a href={`/posts/${post.id}`} class="post-link">
                    <span class="post-icon" aria-hidden="true">
                      {post.data.password ? (
                        <LockKeyhole size={20} stroke-width={1.5} />
                      ) : (
                        <FileText size={20} stroke-width={1.5} />
                      )}
                    </span>
                    <span class="post-copy">
                      <span class="post-title">{post.data.title}</span>
                      {post.data.description && (
                        <span class="post-description">{post.data.description}</span>
                      )}
                      <span class="post-meta">
                        <time datetime={post.data.pubDate.toISOString()}>
                          {post.data.pubDate.toISOString().slice(5, 10).replace("-", ".")}
                        </time>
                        {post.data.tags.length > 0 && (
                          <>
                            <span class="post-meta-rule" aria-hidden="true" />
                            <span class="post-tags">
                              {post.data.tags.map((tag) => (
                                <span>{tag}</span>
                              ))}
                            </span>
                          </>
                        )}
                        {post.data.password && <span class="sr-only">密码保护</span>}
                        {post.data.draft && <span class="post-draft">草稿</span>}
                      </span>
                    </span>
                    <span class="post-arrow" aria-hidden="true">
                      <ArrowUpRight size={16} stroke-width={1.5} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </section>
  <div class="archive-end" aria-hidden="true"></div>
</div>

<style>
  .post-shell {
    min-width: 0;
  }
  .archive-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 28px;
  }
  .archive-bar h2 {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .archive-bar > span {
    color: var(--ui-text-muted);
    font-size: 11px;
  }
  .post-year {
    padding: 10px 28px;
    color: var(--ui-text-muted);
    background: var(--ui-bg-soft);
    font: 400 12px/1.6 var(--font-mono);
    letter-spacing: 0.03em;
  }
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post-link {
    display: grid;
    grid-template-columns: 57px minmax(0, 1fr) 44px;
    padding: 23px 22px 23px 17px;
    color: var(--ui-text);
    text-decoration: none;
  }
  .post-link:hover {
    background: var(--ui-hover);
  }
  .post-link:focus-visible {
    outline-offset: -3px;
  }
  .post-icon {
    display: flex;
    justify-content: center;
    padding-top: 5px;
    color: var(--ui-text-muted);
  }
  .post-copy {
    min-width: 0;
  }
  .post-title {
    display: block;
    font-size: 16px;
    line-height: 1.8;
    font-weight: 500;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }
  .post-description {
    display: block;
    margin-top: 7px;
    color: var(--ui-text-muted);
    font-size: 13px;
    line-height: 1.95;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }
  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 13px;
    color: var(--ui-text-muted);
    font-size: 11px;
    line-height: 1.8;
  }
  .post-meta time {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .post-meta-rule {
    width: 1px;
    height: 9px;
    background: var(--ui-border-strong);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    overflow-wrap: anywhere;
  }
  .post-tags > span + span::before {
    content: "·";
    margin-right: 7px;
  }
  .post-draft {
    border: 1px solid var(--ui-border);
    border-radius: 3px;
    padding-inline: 5px;
  }
  .post-arrow {
    display: flex;
    justify-content: flex-end;
    padding-top: 7px;
    color: var(--ui-text-muted);
  }
  .post-empty {
    padding: 32px 28px;
    color: var(--ui-text-muted);
    font-size: 14px;
  }
  .archive-end {
    height: 32px;
  }
  @media (max-width: 520px) {
    .archive-bar {
      padding: 15px 20px;
    }
    .post-year {
      padding-inline: 20px;
    }
    .post-link {
      grid-template-columns: 41px minmax(0, 1fr) 23px;
      padding: 19px 13px;
    }
    .post-icon {
      padding-top: 4px;
    }
    .post-title {
      font-size: 15px;
    }
    .post-description {
      font-size: 12.5px;
    }
  }
</style>

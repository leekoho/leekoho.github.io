---
import Logo from "@/assets/logo.svg"
---

<a class="brand" href="/" aria-label="leekoho 首页">
  <Logo class="brand-mark" aria-hidden="true" focusable="false" />
  <span>leekoho</span>
</a>

<style>
  @reference "../styles/global.css";

  .brand {
    @apply inline-flex shrink-0 items-center gap-2 text-lg leading-none font-medium tracking-tight text-foreground no-underline sm:gap-3 sm:text-xl;
  }
  .brand :global(.brand-mark) {
    @apply size-7 sm:size-8;
  }
</style>

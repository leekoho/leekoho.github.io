---
import { Lock } from "@lucide/astro"
import Button from "./Button.astro"

interface Props {
  password?: string
}

const { password } = Astro.props

let html = ""
html = await Astro.slots.render("default")

let cipherHTML = ""
let saltStr = ""
let ivStr = ""
let authHash = ""

if (password) {
  const bufToHex = (buf: ArrayBuffer) =>
    Array.from(new Uint8Array(buf))
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("")

  // 生成随机盐和初始向量（各 128 位）
  const salt = crypto.getRandomValues(new Uint8Array(16))
  const iv = crypto.getRandomValues(new Uint8Array(16))

  // 1. 导入密码为 PBKDF2 原材料
  const keyMaterial = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(password),
    "PBKDF2",
    false,
    ["deriveKey"],
  )

  // 2. PBKDF2 推导 AES-CBC 256 位密钥（SHA-256 + 10000 次迭代）
  const aesKey = await crypto.subtle.deriveKey(
    { name: "PBKDF2", salt, iterations: 10000, hash: "SHA-256" },
    keyMaterial,
    { name: "AES-CBC", length: 256 },
    true,
    ["encrypt"],
  )

  // 3. AES-CBC 加密 HTML
  const encryptedBuffer = await crypto.subtle.encrypt(
    { name: "AES-CBC", iv },
    aesKey,
    new TextEncoder().encode(html),
  )

  // 4. 导出密钥 → Hex → SHA-256 凭证哈希（与客户端完全对称）
  const keyBytes = await crypto.subtle.exportKey("raw", aesKey)
  const keyHex = bufToHex(keyBytes)
  const hashBuffer = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(keyHex))

  // Buffer.from 在 Node.js 中处理大文章比 btoa+spread 更安全（无 stack overflow 风险）
  cipherHTML = Buffer.from(encryptedBuffer).toString("base64")
  saltStr = bufToHex(salt.buffer)
  ivStr = bufToHex(iv.buffer)
  authHash = bufToHex(hashBuffer)
}
---

{
  password ? (
    <encrypted-content
      data-cipher={cipherHTML}
      data-salt={saltStr}
      data-iv={ivStr}
      data-hash={authHash}
    >
      <form class="encrypted-panel not-prose" aria-labelledby="encrypt-heading">
        <Lock size={22} stroke-width={1.5} class="encrypted-icon" aria-hidden="true" />
        <h2 class="encrypted-title" id="encrypt-heading">这篇文章需要密码</h2>
        <p class="encrypted-description">输入访问密码，继续阅读。</p>

        <div class="encrypted-controls">
          <label for="encrypt-pwd" class="sr-only">
            文章访问密码
          </label>
          <input
            type="password"
            id="encrypt-pwd"
            autocomplete="current-password"
            aria-describedby="encrypt-error"
            required
            placeholder="输入密码"
            class="encrypted-input"
          />
          <Button id="encrypt-btn" type="submit" size="lg" class="encrypted-button">
            继续阅读
          </Button>
        </div>
        <p id="encrypt-error" class="encrypted-error" role="alert" hidden>
          密码不正确，请重试。
        </p>
        <noscript>
          <p class="encrypted-description">请启用 JavaScript 后输入密码。</p>
        </noscript>
      </form>
    </encrypted-content>
  ) : (
    <Fragment set:html={html} />
  )
}

<script>
  const hexToBuffer = (hex: string) =>
    Uint8Array.from(hex.match(/.{2}/g)!.map((b) => parseInt(b, 16)))

  const bufferToHex = (buf: ArrayBuffer) =>
    Array.from(new Uint8Array(buf))
      .map((b) => b.toString(16).padStart(2, "0"))
      .join("")

  const base64ToBuffer = (b64: string) => Uint8Array.from(atob(b64), (c) => c.charCodeAt(0))

  class EncryptedContent extends HTMLElement {
    connectedCallback() {
      const cipherText = this.dataset.cipher
      const saltStr = this.dataset.salt
      const ivStr = this.dataset.iv
      const authHash = this.dataset.hash

      if (!cipherText || !authHash || !saltStr || !ivStr) return

      const form = this.querySelector("form")
      const btn = this.querySelector<HTMLButtonElement>("#encrypt-btn")
      const input = this.querySelector<HTMLInputElement>("#encrypt-pwd")
      const errorMsg = this.querySelector<HTMLElement>("#encrypt-error")

      if (!form || !btn || !input || !errorMsg) return

      // 预先解析 salt / iv，避免每次 unlock 重复解析
      const saltBuffer = hexToBuffer(saltStr)
      const ivBuffer = hexToBuffer(ivStr)

      const unlock = async () => {
        const pwd = input.value
        if (!pwd || btn.disabled) return

        btn.disabled = true
        btn.innerText = "正在打开…"
        form.setAttribute("aria-busy", "true")
        input.removeAttribute("aria-invalid")
        errorMsg.hidden = true

        try {
          const enc = new TextEncoder()

          // 1. 导入原始密码为 PBKDF2 的原材料
          const keyMaterial = await crypto.subtle.importKey(
            "raw",
            enc.encode(pwd),
            "PBKDF2",
            false,
            ["deriveKey"],
          )

          // 2. PBKDF2 推导 AES-CBC 256 位密钥（SHA-256 / 10000 次，与构建端完全对齐）
          const aesKey = await crypto.subtle.deriveKey(
            { name: "PBKDF2", salt: saltBuffer, iterations: 10000, hash: "SHA-256" },
            keyMaterial,
            { name: "AES-CBC", length: 256 },
            true, // extractable=true 以便导出字节做凭证哈希校验
            ["decrypt"],
          )

          // 3. 导出密钥字节，转为 Hex 字符串，对 Hex 字符串求哈希，与构建端方式完全对齐
          const keyBytes = await crypto.subtle.exportKey("raw", aesKey)
          const keyHex = bufferToHex(keyBytes)
          const hashBuffer = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(keyHex))
          const inputHash = bufferToHex(hashBuffer)

          if (inputHash !== authHash) {
            errorMsg.textContent = "密码不正确，请重试。"
            errorMsg.hidden = false
            input.setAttribute("aria-invalid", "true")
            input.focus()
            return
          }

          // 4. 密码正确，AES-CBC 解密（CryptoJS .toString() 输出纯 Base64 密文）
          let decryptedBuffer: ArrayBuffer
          try {
            decryptedBuffer = await crypto.subtle.decrypt(
              { name: "AES-CBC", iv: ivBuffer },
              aesKey,
              base64ToBuffer(cipherText),
            )
          } catch (decryptErr) {
            console.error(
              "[EncryptedContent] decrypt() failed — 凭证校验通过但解密异常，请检查两端 IV / 加密模式是否对齐:",
              decryptErr,
            )
            throw decryptErr
          }

          if (decryptedBuffer.byteLength === 0) throw new Error("解密结果为空")
          this.outerHTML = new TextDecoder().decode(decryptedBuffer)
        } catch (e) {
          console.error(e)
          errorMsg.textContent = "暂时无法打开文章，请重试。"
          errorMsg.hidden = false
        } finally {
          form.removeAttribute("aria-busy")
          btn.disabled = false
          btn.innerText = "继续阅读"
        }
      }

      form.addEventListener("submit", (event) => {
        event.preventDefault()
        void unlock()
      })
      input.addEventListener("input", () => {
        errorMsg.hidden = true
        input.removeAttribute("aria-invalid")
      })
    }
  }

  customElements.define("encrypted-content", EncryptedContent)
</script>

<style>
  @reference "../styles/global.css";

  encrypted-content {
    @apply block;
  }
  .encrypted-panel {
    @apply m-0 rounded-md border border-border bg-background-muted px-4 py-8 text-center sm:px-6;
  }
  :global(.encrypted-icon) {
    @apply mx-auto mb-4 text-muted;
  }
  .encrypted-title {
    @apply mb-2 text-lg leading-7 font-medium text-foreground;
  }
  .encrypted-description {
    @apply m-0 text-sm leading-7 text-muted;
  }
  .encrypted-controls {
    @apply mx-auto mt-6 flex max-w-sm flex-col items-center gap-4 sm:flex-row;
  }
  .encrypted-input {
    @apply h-11 w-full min-w-0 rounded-sm border border-border bg-background px-3 py-2 text-base leading-6 text-foreground placeholder:text-muted sm:text-sm;
  }
  .encrypted-button {
    @apply w-full sm:w-auto;
  }
  .encrypted-error {
    @apply mt-4 text-xs leading-relaxed text-foreground-soft;
  }
</style>

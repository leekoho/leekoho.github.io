<script is:inline>
  ;(() => {
    const storageKey = "theme-preference"
    const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)")
    const normalize = (value) => (["light", "dark", "system"].includes(value) ? value : "system")
    let preference = "system"
    try {
      preference = normalize(localStorage.getItem(storageKey))
    } catch {}

    const syncRoot = (root, value) => {
      root.dataset.themePreference = value
      root.classList.toggle("dark", value === "dark" || (value === "system" && mediaQuery.matches))
    }

    const apply = (value, persist = true) => {
      preference = normalize(value)
      syncRoot(document.documentElement, preference)
      if (persist) {
        try {
          localStorage.setItem(storageKey, preference)
        } catch {}
      }
      window.dispatchEvent(new CustomEvent("theme-change"))
    }

    window.__themeController = { getPreference: () => preference, apply }
    apply(preference, false)
    mediaQuery.addEventListener("change", () => {
      if (preference === "system") apply("system", false)
    })

    // ClientRouter 会用新页面的 <html> 属性覆盖运行时写上去的 class，而 is:inline
    // 脚本在客户端导航时不会二次执行；在 swap 前把主题写进新文档，属性会被一并
    // 搬到活动文档，浏览器尚未绘制新页面，因此不会闪白。
    document.addEventListener("astro:before-swap", (event) => {
      syncRoot(event.newDocument.documentElement, preference)
    })
  })()
</script>

---
import { Moon, Sun, Monitor, Check } from "@lucide/astro"
import Button from "../Button.astro"

const options = [
  { value: "light", label: "浅色", icon: Sun },
  { value: "dark", label: "深色", icon: Moon },
  { value: "system", label: "跟随系统", icon: Monitor },
]
---

<details class="theme-switcher" data-theme-switcher>
  <Button as="summary" variant="outline" size="icon" class="theme-trigger">
    <Sun class="icon-light" size={16} stroke-width={1.5} aria-hidden="true" />
    <Moon class="icon-dark" size={16} stroke-width={1.5} aria-hidden="true" />
    <Monitor class="icon-system" size={16} stroke-width={1.5} aria-hidden="true" />
    <span class="sr-only">切换主题</span>
  </Button>
  <div class="theme-menu" role="group" aria-label="外观">
    {
      options.map((option) => (
        <Button variant="ghost" class="theme-option" data-theme-option={option.value}>
          <option.icon size={16} stroke-width={1.5} aria-hidden="true" />
          <span class="theme-label">{option.label}</span>
          <Check class="theme-check" size={14} aria-hidden="true" />
        </Button>
      ))
    }
  </div>
</details>

<script is:inline>
  ;(() => {
    document.querySelectorAll("[data-theme-switcher]").forEach((switcher) => {
      if (switcher.dataset.ready === "true") return
      const trigger = switcher.querySelector("summary")
      const syncSelection = () => {
        const current = window.__themeController?.getPreference() ?? "system"
        switcher.dataset.theme = current
        switcher.querySelectorAll("[data-theme-option]").forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.themeOption === current))
        })
      }
      switcher.querySelectorAll("[data-theme-option]").forEach((button) => {
        button.addEventListener("click", () => {
          window.__themeController?.apply(button.dataset.themeOption)
          switcher.open = false
          trigger.focus()
        })
      })
      document.addEventListener("click", (event) => {
        if (!switcher.contains(event.target)) switcher.open = false
      })
      switcher.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          switcher.open = false
          trigger.focus()
        }
      })
      window.addEventListener("theme-change", syncSelection)
      syncSelection()
      switcher.dataset.ready = "true"
    })
  })()
</script>

<style>
  @reference "../../styles/global.css";

  .theme-switcher {
    @apply relative;
  }
  .theme-trigger {
    @apply text-muted hover:text-foreground;
  }
  :global(.icon-light) {
    @apply hidden;
  }
  :global(.icon-dark) {
    @apply hidden;
  }
  :global(.icon-system) {
    @apply hidden;
  }
  .theme-menu {
    @apply absolute top-full right-0 z-30 mt-2 grid min-w-36 gap-1 rounded-md border border-border bg-surface p-1 shadow-card;
  }
  .theme-option {
    @apply w-full justify-start px-3 text-left font-normal text-muted aria-pressed:bg-hover aria-pressed:text-foreground;
  }
  .theme-label {
    @apply flex-1 whitespace-nowrap;
  }
  :global(.theme-check) {
    @apply opacity-0;
  }
  .theme-option[aria-pressed="true"] :global(.theme-check) {
    @apply opacity-100;
  }
  .theme-switcher[data-theme="light"] :global(.icon-light),
  .theme-switcher[data-theme="dark"] :global(.icon-dark),
  .theme-switcher[data-theme="system"] :global(.icon-system) {
    @apply block;
  }
</style>

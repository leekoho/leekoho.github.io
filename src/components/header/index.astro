---
import Brand from "@/components/Brand.astro"
import ModeToggle from "./ModeToggle.astro"

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
const links = [
  {
    href: "/posts",
    label: "文章",
    active: pathname === "/" || pathname === "/posts" || pathname.startsWith("/posts/"),
  },
  { href: "/about", label: "关于", active: pathname === "/about" },
]
---

<header class="header page-rule">
  <Brand />
  <nav aria-label="主导航">
    {
      links.map((link) => (
        <a class="nav-link" href={link.href} aria-current={link.active ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions"><ModeToggle /></div>
</header>

<style>
  .header {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    height: 66px;
    gap: 22px;
    padding: 0 24px;
  }
  nav {
    display: flex;
    align-self: stretch;
    gap: 24px;
    margin-left: auto;
  }
  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--ui-text-muted);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--ui-text);
  }
  .nav-link[aria-current="page"]::after {
    content: "";
    position: absolute;
    height: 2px;
    bottom: -1px;
    inset-inline: 0;
    background: var(--ui-text);
  }
  .header-actions {
    padding-left: 18px;
    border-left: 1px solid var(--ui-border);
  }
  @media (max-width: 520px) {
    .header {
      height: 61px;
      gap: 16px;
      padding: 0 18px;
    }
    nav {
      gap: 19px;
    }
    .header-actions {
      padding-left: 13px;
    }
  }
  @media (max-width: 340px) {
    .header {
      gap: 10px;
      padding: 0 13px;
    }
    nav {
      gap: 14px;
    }
    .header-actions {
      padding-left: 9px;
    }
  }
</style>

---
import Brand from "@/components/Brand.astro"
import ModeToggle from "./ModeToggle.astro"

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
const links = [
  {
    href: "/posts",
    label: "Blog",
    active: pathname === "/" || pathname === "/posts" || pathname.startsWith("/posts/"),
  },
  { href: "/about", label: "About", active: pathname === "/about" },
]
---

<header class="header page-rule">
  <Brand />
  <nav aria-label="主导航">
    {
      links.map((link) => (
        <a class="nav-link" href={link.href} aria-current={link.active ? "page" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions"><ModeToggle /></div>
</header>

<style>
  @reference "../../styles/global.css";

  .header {
    @apply relative z-20 flex h-16 items-center gap-3 px-4 sm:gap-6 sm:px-6;
  }
  nav {
    @apply ml-auto flex gap-4 self-stretch sm:gap-6;
  }
  .nav-link {
    @apply relative flex items-center text-sm tracking-wide text-muted no-underline hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-0 aria-[current=page]:after:-bottom-px aria-[current=page]:after:h-0.5 aria-[current=page]:after:bg-foreground;
  }
  .header-actions {
    @apply border-l border-border pl-3 sm:pl-4;
  }
</style>
